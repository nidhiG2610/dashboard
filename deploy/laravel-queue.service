[Unit]
Description=Laravel Queue Worker
After=network.target redis-server.service
Requires=redis-server.service

[Service]
Type=simple
User=ubuntu
Group=www-data
WorkingDirectory=/var/www/dashboard/backend
ExecStart=/usr/bin/php artisan queue:work redis --sleep=3 --tries=3 --timeout=90 --backoff=5 --max-time=3600
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
